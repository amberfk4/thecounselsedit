{
  "name": "the-counsels-edit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "predev": "node scripts/sync-sanity.mjs --remote",
    "prebuild": "node scripts/sync-sanity.mjs",
    "postbuild": "node scripts/sync-sanity.mjs --copy",
    "sync": "node scripts/sync-sanity.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint",
    "studio": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.154.0"
  }
}
